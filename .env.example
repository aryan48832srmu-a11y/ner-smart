# ---------------------------------------------------------------------------
# NDRMS environment configuration
# ---------------------------------------------------------------------------
# NDRMS runs keylessly. No paid API or map token is required.
# Real road geometry comes from public OSRM servers, live incidents from
# GDACS/USGS public feeds, and maps from public raster tiles.
# Roads, facilities, forecasts and ML scores remain simulated demo data and
# are labelled as such in the UI. Seeded demo incidents are never shown.

# Backend settings (see backend/.env.example)
# APP_NAME=NDRMS
# APP_ENV=demo
# DEBUG=true

# Frontend API base URL (dev uses the Vite proxy /api -> localhost:8000)
# Set to a full URL only if you bypass the Vite proxy.
# VITE_API_BASE_URL=/api

# Optional live weather source (leave empty for simulated weather)
# Set this only in backend/.env, never in frontend files or git.
# OPENWEATHER_API_KEY=