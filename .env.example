# ---------------------------------------------------------------------------
# NER-SMART environment configuration
# ---------------------------------------------------------------------------
# This prototype runs in DEMO MODE. No external API keys are required.
# All data is simulated and clearly labelled "Demo Data".

# Backend settings (see backend/.env.example)
# APP_NAME=NER-SMART
# APP_ENV=demo
# DEBUG=true

# Frontend API base URL (dev uses the Vite proxy /api -> localhost:8000)
# Set to a full URL only if you bypass the Vite proxy.
# VITE_API_BASE_URL=/api

# Optional live weather source (leave empty for simulated weather)
# Requires DEMO_MODE=false on the backend.
# OPENWEATHER_API_KEY=