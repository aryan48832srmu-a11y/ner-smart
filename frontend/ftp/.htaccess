# NER-SMART static frontend (Apache / LiteSpeed shared hosting)
#
# Serve index.html for client-side routes such as /route-planner and
# /logistics, while returning real 404s for missing assets.
#
# Kept deliberately minimal: `Options`/`Header` directives are wrapped in
# <IfModule> guards so a host with restrictive AllowOverride returns the site
# instead of a 500 error.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite existing files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a React Router URL.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change, so cache them aggressively.
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The entry point must always be revalidated after a new upload.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
