# ---------------------------------------------------------------------------
# NDRMS backend configuration (copy to backend/.env to override)
# ---------------------------------------------------------------------------
# No API keys are required for routing or live incidents. Only weather is
# optional. NEVER commit backend/.env — it can hold a real weather key.

APP_NAME=NDRMS
APP_VERSION=1.3.0
APP_ENV=production
DEBUG=false

# SQLite database path (relative to backend/ or absolute)
DATABASE_URL=sqlite:///./nersmart.db

# CORS for a separately hosted frontend (static FTP build)
CORS_ALLOW_ALL=true
CORS_ORIGINS=*

# Optional live weather. Leave empty for the simulated fallback.
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_TIMEOUT_SECONDS=10.0

# Public road routing (Valhalla first, then OSRM). No key required.
ROUTING_TIMEOUT_SECONDS=8.0
ROUTING_CACHE_TTL_SECONDS=600
ROUTING_PROVIDERS=valhalla,osrm-public,osrm-de

# Live incidents from public GDACS + USGS feeds. No key required.
LIVE_INCIDENTS_ENABLED=true
LIVE_INCIDENTS_CACHE_TTL_SECONDS=600
LIVE_INCIDENTS_TIMEOUT_SECONDS=10.0

# Optional: absolute path to a built frontend served by the API
FRONTEND_DIST=
